#!/usr/bin/env python3
"""claude-close-keep-screen - close a running Claude session, leaving it resumable in its tmux pane.

  claude-close-keep-screen close <uuid | uuid prefix | %pane>   close one Claude session by hand
  claude-close-keep-screen idle --over <hours> [--dry-run]       close the Claude sessions idle for longer than <hours>
  claude-close-keep-screen self                                   close the Claude session this runs from (`!claude-close-keep-screen self`)
  claude-close-keep-screen hook                                   Claude Code's UserPromptSubmit hook: `/close` = `self`, no model call

A close: capture the tmux pane's screen, SIGTERM the Claude process (never SIGKILL: Claude Code
flushes its transcript on SIGTERM), write the screen file, cat it back into the pane and pre-type
`claude --resume <uuid>` there (no Enter).
`self` (and `/close`, through the hook) is the one way to close the Claude session you are in (the user, 2026-11-23):
it checks, starts a detached helper and returns; the helper waits until the session is idle (the `!` command or the
blocked prompt has ended), then closes it and shows its screen with a summary box. Ported from `asm close` (agent-session-manager
src/asm, lines 1538-1750, v4.7), with two more safety checks (the pid's start time, and the pane
really holding the pid).

Reads:  $CLAUDE_CONFIG_DIR/sessions/<pid>.json (Claude Code's own file per running Claude session),
        $CLAUDE_CONFIG_DIR/projects/*/<uuid>.jsonl (transcripts, for the last prompt),
        `agent-tracker now --json` when it is on the PATH (last prompt, pane, transcript).
Writes: $CLAUDE_CLOSE_KEEP_SCREEN_HOME/data/close-screens/<uuid>.txt, $CLAUDE_CLOSE_KEEP_SCREEN_HOME/logs/close.jsonl,
        $CLAUDE_CLOSE_KEEP_SCREEN_HOME/logs/self.log (the detached helper's errors)
"""

import argparse
import glob
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from typing import Any, Dict, List, Optional

VERSION = "1.1"
APP_HOME = os.environ.get("CLAUDE_CLOSE_KEEP_SCREEN_HOME") or os.path.expanduser("~/opt/claude-close-keep-screen")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
SCREENS_DIR = os.path.join(APP_HOME, "data", "close-screens")
LOG_PATH = os.path.join(APP_HOME, "logs", "close.jsonl")
TERM_TIMEOUT_S = 5.0          # asm close's value: wait this long for the process to exit after SIGTERM
SELF_LOG_PATH = os.path.join(APP_HOME, "logs", "self.log")
# self: how long the helper waits for the session to become idle (a `!` command ends at once; a /close that the hook
# missed goes to the model, whose turn may take a minute), then how long it lets the screen redraw before capturing it.
SELF_WAIT_S = float(os.environ.get("CLAUDE_CLOSE_KEEP_SCREEN_SELF_WAIT_S") or 120)
SELF_SETTLE_S = 1.0
CLOSE_PROMPT = "/close"
LSTART_RE = re.compile(r"^[A-Z][a-z]{2} [A-Z][a-z]{2} +\d+ \d\d:\d\d:\d\d \d{4}$")   # `ps -o lstart` shape


class Refused(Exception):
    """A safety check failed: nothing was touched."""


class CloseFailed(Exception):
    """SIGTERM was sent but the process did not exit: the pane was left untouched."""


def dt_of(ts: float) -> str:
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(v: Any) -> Optional[float]:
    """Epoch seconds from an epoch number (s or ms), an ISO string, or a dict holding ts/dt."""
    if isinstance(v, dict):
        return parse_ts(v.get("ts")) or parse_ts(v.get("dt")) or parse_ts(v.get("timestamp"))
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return v / 1000 if v > 1e11 else float(v)
    if isinstance(v, str) and v:
        try:
            return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def human_age(seconds: float) -> str:
    """'7m', '3h20m' or '2d13h' (asm's _human_age)."""
    mins = int(max(0, seconds)) // 60
    if mins < 60:
        return f"{mins}m"
    if mins < 1440:
        return f"{mins // 60}h{mins % 60}m"
    return f"{mins // 1440}d{(mins % 1440) // 60}h"


def log(row: Dict[str, Any]) -> None:
    """One line per close or refusal; ts and dt first."""
    ts = time.time()
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "a", encoding="utf-8") as f:
        f.write(json.dumps({"ts": int(ts), "dt": dt_of(ts), **row}) + "\n")


# -- Finding the running Claude sessions -------------------------------------

def tracker_rows() -> Dict[str, Dict[str, Any]]:
    """`agent-tracker now --json` by uuid, or {} when agent-tracker is not installed or fails.
    Only used to add the last prompt, the pane and the transcript path; the pid, status and kind
    always come from $CLAUDE_CONFIG_DIR/sessions/<pid>.json."""
    if not shutil.which("agent-tracker"):
        return {}
    try:
        out = subprocess.run(["agent-tracker", "now", "--json"], capture_output=True, text=True, timeout=10).stdout
        doc = json.loads(out)
    except (subprocess.SubprocessError, OSError, ValueError):
        return {}
    l_rows = doc.get("sessions", []) if isinstance(doc, dict) else doc
    return {r.get("uuid"): r for r in l_rows if isinstance(r, dict) and r.get("uuid")}


def live_sessions(with_tracker: bool = True) -> List[Dict[str, Any]]:
    """Every running local Claude session: Claude Code writes one sessions/<pid>.json per process."""
    d_tracker = tracker_rows() if with_tracker else {}
    l_sessions = []
    for path in sorted(glob.glob(os.path.join(CLAUDE_DIR, "sessions", "*.json"))):
        try:
            with open(path, encoding="utf-8") as f:
                s = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(s, dict) and s.get("sessionId"):
            s["_tracker"] = d_tracker.get(s["sessionId"], {})
            l_sessions.append(s)
    return l_sessions


def pane_id_of(s: Dict[str, Any]) -> Optional[str]:
    """The %pane of a session: sessions/<pid>.json's tmux is "session:@window.%pane"."""
    tail = (s.get("tmux") or "").split(".")[-1]
    if tail.startswith("%"):
        return tail
    pid = s["_tracker"].get("pane_id")
    return pid if isinstance(pid, str) and pid.startswith("%") else None


def find_session(target: str, with_tracker: bool = True) -> Dict[str, Any]:
    """The one running Claude session matching a uuid, a uuid prefix or a %pane."""
    l_sessions = live_sessions(with_tracker)
    if target.startswith("%"):
        l_match = [s for s in l_sessions if pane_id_of(s) == target]
    else:
        l_match = [s for s in l_sessions if s["sessionId"] == target] or \
                  [s for s in l_sessions if target and s["sessionId"].startswith(target)]
    if len(l_match) > 1:
        lines = "\n".join(f"  pid {s.get('pid')}  {s.get('name')}  {s['sessionId']}" for s in l_match)
        raise Refused(f"several running Claude sessions match '{target}':\n{lines}")
    if not l_match:
        raise Refused(f"no running Claude session matches '{target}' (already exited, or on another machine).")
    return l_match[0]


def own_session() -> Dict[str, Any]:
    """The Claude session this command runs from: the one whose pid is an ancestor of this process."""
    l_chain = ancestors(os.getpid(), ps_parents())
    l_match = [s for s in live_sessions(with_tracker=False) if s.get("pid") in l_chain]
    if not l_match:
        raise Refused("not running inside a Claude session (no ancestor process has a sessions/<pid>.json).")
    return min(l_match, key=lambda s: l_chain.index(s["pid"]))     # the nearest one


def transcript_of(s: Dict[str, Any]) -> Optional[str]:
    path = s["_tracker"].get("transcript")
    if isinstance(path, str) and os.path.isfile(path):
        return path
    l_paths = glob.glob(os.path.join(CLAUDE_DIR, "projects", "*", f"{s['sessionId']}.jsonl"))
    return max(l_paths, key=os.path.getmtime) if l_paths else None


def is_tool_result(entry: Dict[str, Any]) -> bool:
    """A `user` entry that is really a tool result, not a human prompt (asm's is_tool_result)."""
    content = (entry.get("message") or {}).get("content", "")
    return isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content)


def is_not_typed(e: Dict[str, Any]) -> bool:
    """A `user` entry the user did not type: a meta entry (the /rename reminder, a skill's text), a compact
    summary, a task notification or a system reminder. agent-tracker's last_prompt skips the same ones."""
    if e.get("isMeta") or e.get("isCompactSummary"):
        return True
    content = (e.get("message") or {}).get("content")
    if isinstance(content, list):
        content = " ".join(x.get("text", "") for x in content if isinstance(x, dict) and x.get("type") == "text")
    return isinstance(content, str) and content.lstrip().startswith(("<task-notification>", "<system-reminder>"))


def prompt_text(e: Dict[str, Any]) -> str:
    content = (e.get("message") or {}).get("content", "")
    if isinstance(content, list):
        content = " ".join(x.get("text", "") for x in content if isinstance(x, dict) and x.get("type") == "text")
    return " ".join(str(content).split())


def last_prompt_ts(s: Dict[str, Any]) -> Optional[float]:
    """The last prompt's time: agent-tracker's when it gives one, else the end of the transcript."""
    ts = parse_ts(s["_tracker"].get("last_prompt"))
    return ts or last_prompt(s)[0]


def last_prompt(s: Dict[str, Any]) -> tuple:
    """(time, text) of the transcript's last `user` entry that is not a tool result, or (None, ""). Reads 1 MB from
    the end, then 4x more each time nothing is found, up to the whole file."""
    path = transcript_of(s)
    if not path:
        return None, ""
    size, chunk = os.path.getsize(path), 1 << 20
    while True:
        start = max(0, size - chunk)
        with open(path, "rb") as f:
            f.seek(start)
            l_lines = f.read().split(b"\n")
        if start > 0:
            l_lines = l_lines[1:]          # the first line is cut
        for raw in reversed(l_lines):
            if b'"user"' not in raw:
                continue
            try:
                e = json.loads(raw)
            except ValueError:
                continue                   # a line being written right now
            if isinstance(e, dict) and e.get("type") == "user" and not is_tool_result(e) and not is_not_typed(e):
                ts = parse_ts(e.get("timestamp"))
                if ts:
                    return ts, prompt_text(e)
        if start == 0:
            return None, ""
        chunk *= 4


# -- Safety checks -------------------------------------------------------------

def ps_parents() -> Dict[int, int]:
    out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True).stdout
    return {int(a): int(b) for a, b in (l.split() for l in out.splitlines() if len(l.split()) == 2)}


def ancestors(pid: int, d_parent: Dict[int, int]) -> List[int]:
    """pid itself, then its parent, grand-parent... up to pid 1."""
    l_chain = []
    while pid and pid not in l_chain:
        l_chain.append(pid)
        pid = d_parent.get(pid, 0)
    return l_chain


def check_closeable(s: Dict[str, Any], self_close: bool = False, ignore_busy: bool = False) -> Optional[str]:
    """Every safety check, cheapest first, before anything is captured or signalled; returns the %pane, or None for
    a session attached to no terminal (non-interactive, background): that one only gets a plain SIGTERM, there is no
    screen to keep (the user, 2026-11-19). A session in a terminal outside tmux is refused: SIGTERM would wipe its screen.
    The first six are asm close's; the pid start time and the pane-holds-pid checks are new: they stop
    a stale sessions/<pid>.json from sending SIGTERM or keys to a process or pane that is not its own.
    self_close: `self` only (the one way to close your own session); ignore_busy: `self` before it detaches (the
    session is busy running it; the helper waits for idle, then runs every check again without ignore_busy)."""
    pid, uuid = s.get("pid"), s["sessionId"]
    d_parent = ps_parents()
    if not self_close and (os.environ.get("CLAUDE_CODE_SESSION_ID") == uuid or
                           (isinstance(pid, int) and pid in ancestors(os.getpid(), d_parent))):
        raise Refused("refusing to close the Claude session this command is running from (use `self`, or /close in it).")
    if s.get("status") == "busy" and not ignore_busy:
        raise Refused("the Claude session is busy (mid-task): never close a busy Claude session.")
    pane_id = pane_id_of(s) if s.get("kind") == "interactive" else None
    if not pane_id and tty_of(pid):
        raise Refused(f"the Claude session has a terminal ({tty_of(pid)}) but no tmux pane to keep its screen in: not handled.")
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, TypeError, OverflowError):
        raise Refused(f"pid {pid} is not running: stale sessions/{pid}.json.")
    except PermissionError:
        raise Refused(f"pid {pid} belongs to another user.")
    proc_start = s.get("procStart") or ""
    if LSTART_RE.match(proc_start):     # Claude Code writes `ps -o lstart` in UTC, C locale
        lstart = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                                env={**os.environ, "TZ": "UTC", "LC_ALL": "C"}).stdout
        if " ".join(lstart.split()) != " ".join(proc_start.split()):
            raise Refused(f"pid {pid} started at '{lstart.strip()}', not '{proc_start}': the pid was reused, stale sessions/{pid}.json.")
    if not pane_id:
        return None
    out = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{pane_id} #{pane_pid}"], capture_output=True, text=True).stdout
    d_pane_pid = {a: int(b) for a, b in (l.split() for l in out.splitlines() if len(l.split()) == 2)}
    if pane_id not in d_pane_pid:
        raise Refused(f"tmux pane {pane_id} (from '{s.get('tmux')}') no longer exists: stale reference.")
    if d_pane_pid[pane_id] not in ancestors(pid, d_parent):
        raise Refused(f"tmux pane {pane_id} does not hold pid {pid}: stale reference.")
    return pane_id


# -- The close -------------------------------------------------------------------

def rss_mb(pid: int) -> Optional[int]:
    out = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return int(out) // 1024 if out.isdigit() else None


def tty_of(pid: Any) -> str:
    """The process's terminal (ttys003, pts/2), or '' when it has none (ps prints ?? on macOS, ? on Linux)."""
    out = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return "" if out in ("", "?", "??") else out


def terminate(pid: int) -> None:
    """SIGTERM and wait for the process to go; never SIGKILL (asm's _terminate)."""
    os.kill(pid, signal.SIGTERM)
    deadline = time.time() + TERM_TIMEOUT_S
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.25)
    raise CloseFailed(f"pid {pid} did not exit within {TERM_TIMEOUT_S:.0f} s of SIGTERM: the pane was left untouched; "
                      f"check it by hand before retrying (it may be flushing a large transcript).")


ANSI = {"bold": "\033[1m", "dim": "\033[2m", "green": "\033[32m", "cyan": "\033[36m", "yellow": "\033[33m", "off": "\033[0m"}


def cut(text: Any, n: int) -> str:
    """One line of at most n characters ('…' when cut)."""
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:max(0, n - 1)] + "…"


def cut_middle(text: Any, n: int) -> str:
    """A path in at most n characters, its end kept (the file name): '/home/…/close-screens/<uuid>.txt'."""
    text = str(text)
    if len(text) <= n:
        return text
    head = max(0, (n - 1) // 3)
    return text[:head] + "…" + text[len(text) - (n - 1 - head):]


ANSI_RE = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def without_input_box(l_lines: List[str]) -> List[str]:
    """Claude Code's screen without its bottom: the empty input box (a ──── rule, the ❯ line, a ──── rule) and the
    status lines under it; the summary box replaces them. Unchanged when that shape is not found."""
    l_plain = [ANSI_RE.sub("", l).strip() for l in l_lines]
    for i in range(len(l_plain) - 2, 0, -1):
        if l_plain[i].startswith("❯") and set(l_plain[i - 1]) == {"─"} and set(l_plain[i + 1]) == {"─"}:
            return l_lines[:i - 1]
    return l_lines


def local_time(ts: float) -> str:
    return datetime.fromtimestamp(ts).astimezone().strftime("%Y-%m-%d %H:%M %Z")


def summary_box(s: Dict[str, Any], mem: Optional[int], closed_ts: float, screen: str, width: int) -> str:
    """The box shown under the kept screen after `self`: what was closed, and how to resume it. Coloured with ANSI;
    the padding is counted on the plain text (every character used here is one column wide)."""
    a = ANSI
    inner = max(50, min(width, 100)) - 2
    uuid = s["sessionId"]
    started = parse_ts(s.get("startedAt"))
    lp_ts, lp_text = last_prompt(s)
    l_rows = [("Name", s.get("name") or "-"), ("Session", uuid), ("Folder", s.get("cwd") or "-")]
    if started:
        l_rows.append(("Ran for", f"{human_age(closed_ts - started)} (since {local_time(started)})"))
    if lp_ts:
        l_rows.append(("Last prompt", f"{human_age(closed_ts - lp_ts)} ago: {lp_text}"))
    l_rows += [("Memory", f"{mem} MB freed" if mem is not None else "-"),
               ("Transcript", transcript_of(s) or "-"), ("Screen file", screen)]
    l_paths = ("Folder", "Transcript", "Screen file")

    def line(plain: str, styled: str) -> str:
        return f"{a['cyan']}│{a['off']}{styled}{' ' * (inner - len(plain))}{a['cyan']}│{a['off']}"
    rule = lambda l, r: f"{a['cyan']}{l}{'─' * inner}{r}{a['off']}"
    title = " " + cut(f"✔ Claude session closed at {local_time(closed_ts)}: its screen is kept above", inner - 1)
    l_out = [rule("╭", "╮"), line(title, f"{a['bold']}{a['green']}{title}{a['off']}"), rule("├", "┤")]
    for key, val in l_rows:
        key = f" {key:<12}"
        val = (cut_middle if key.strip() in l_paths else cut)(val, inner - len(key) - 1)
        l_out.append(line(key + val, f"{a['dim']}{key}{a['off']}{val}"))
    resume = " " + cut(f"▶ Press Enter to resume: claude --resume {uuid}", inner - 1)
    l_out += [rule("├", "┤"), line(resume, f"{a['bold']}{a['yellow']}{resume}{a['off']}"), rule("╰", "╯")]
    return "\n".join(l_out) + "\n"


def close(s: Dict[str, Any], by: str, self_close: bool = False) -> Optional[str]:
    """Close one running Claude session; returns the screen file (None for a session with no terminal: plain SIGTERM).
    self_close: the session is the one `self` ran from: no self refusal, and its screen comes back cleared, with
    the summary box under it. Raises Refused or CloseFailed."""
    pid, uuid = s.get("pid"), s["sessionId"]
    name = s.get("name") or uuid
    try:
        pane_id = check_closeable(s, self_close=self_close)
    except Refused as e:
        log({"event": "refused", "by": by, "uuid": uuid, "name": name, "pid": pid, "reason": str(e)})
        raise
    idle_s = time.time() - (parse_ts(s.get("statusUpdatedAt")) or time.time())
    mem = rss_mb(pid)
    print(f"  status={s.get('status')}  idle={human_age(idle_s)}  mem={mem}MB  pane={pane_id}  cwd={s.get('cwd')}", flush=True)

    if pane_id is None:                # no terminal: nothing to keep on screen, a plain SIGTERM
        try:
            terminate(pid)
        except CloseFailed as e:
            log({"event": "close_failed", "by": by, "uuid": uuid, "name": name, "pid": pid, "pane": None, "reason": str(e)})
            raise
        log({"event": "close", "by": by, "uuid": uuid, "name": name, "pid": pid, "pane": None, "kind": s.get("kind"),
             "idle_minutes": int(idle_s // 60), "last_prompt_ts": s.get("_last_prompt_ts"), "mem_mb_freed": mem, "screen_file": None})
        print(f"  closed (no terminal: plain SIGTERM): {mem}MB freed. Resume: claude --resume {uuid}", flush=True)
        return None

    # Capture BEFORE terminating: the conversation lives on the terminal's alternate screen,
    # which is torn down the moment the process exits.
    capture = subprocess.run(["tmux", "capture-pane", "-p", "-e", "-t", pane_id], capture_output=True, text=True).stdout
    try:
        terminate(pid)
    except CloseFailed as e:
        log({"event": "close_failed", "by": by, "uuid": uuid, "name": name, "pid": pid, "pane": pane_id, "reason": str(e)})
        raise

    closed_ts = time.time()
    os.makedirs(SCREENS_DIR, exist_ok=True)
    screen = os.path.join(SCREENS_DIR, f"{uuid}.txt")
    with open(screen, "w", encoding="utf-8") as f:
        if self_close:
            l_lines = without_input_box(capture.rstrip("\n").split("\n"))
            while l_lines and not ANSI_RE.sub("", l_lines[-1]).strip():
                l_lines.pop()                       # the pane's empty bottom lines
            width = subprocess.run(["tmux", "display", "-p", "-t", pane_id, "#{pane_width}"],
                                   capture_output=True, text=True).stdout.strip()
            f.write("\n".join(l_lines) + "\n" + summary_box(s, mem, closed_ts, screen, int(width) if width.isdigit() else 80))
        else:
            f.write(f"───── CLOSED {dt_of(closed_ts)} · idle {human_age(idle_s)} · {mem}MB freed ─────\n")
            f.write(capture if capture.endswith("\n") else capture + "\n")
            f.write(f"───── resume: claude --resume {uuid} (typed below: press Enter) ─────\n")

    # cat puts the text in the pane's normal screen, so it stays; the resume command is typed
    # without Enter: the pane becomes its own resume button. self: the screen is cleared first, so the kept screen
    # starts at the top; the leading space keeps the line out of the shell's history (ignorespace).
    show = f" printf '\\033[H\\033[2J'; cat {shlex.quote(screen)}" if self_close else f"cat {shlex.quote(screen)}"
    subprocess.run(["tmux", "send-keys", "-t", pane_id, "-l", show])
    subprocess.run(["tmux", "send-keys", "-t", pane_id, "Enter"])
    if self_close:     # let cat finish first: keys typed meanwhile are echoed by the terminal, then again by the shell
        time.sleep(0.3)
        for _ in range(20):
            cmd = subprocess.run(["tmux", "display", "-p", "-t", pane_id, "#{pane_current_command}"],
                                 capture_output=True, text=True).stdout.strip()
            if cmd != "cat":
                break
            time.sleep(0.1)
    subprocess.run(["tmux", "send-keys", "-t", pane_id, f"claude --resume {uuid}"])
    subprocess.run(["tmux", "select-pane", "-t", pane_id, "-T", f"closed: {name}"], stderr=subprocess.DEVNULL)
    log({"event": "close", "by": by, "uuid": uuid, "name": name, "pid": pid, "pane": pane_id,
         "idle_minutes": int(idle_s // 60), "last_prompt_ts": s.get("_last_prompt_ts"), "mem_mb_freed": mem,
         "screen_file": screen})
    print(f"  closed: {mem}MB freed. Screen file: {screen}", flush=True)
    return screen


# -- Commands ------------------------------------------------------------------------

def cmd_close(target: str) -> int:
    try:
        s = find_session(target)
        print(f"Target: {s.get('name') or s['sessionId']} (pid {s.get('pid')}, Claude session {s['sessionId']})", flush=True)
        close(s, by="hand")
        return 0
    except (Refused, CloseFailed) as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1


def cmd_idle(over_h: float, dry_run: bool) -> int:
    """Claude sessions whose status is idle and whose last prompt is older than over_h hours."""
    now = time.time()
    l_sessions = live_sessions()
    l_picked = []
    for s in l_sessions:
        if s.get("status") != "idle":
            continue
        ts = last_prompt_ts(s)
        if ts is None:
            print(f"  skipped {s['sessionId'][:8]} ({s.get('name')}): no last prompt found (no transcript)", file=sys.stderr)
            continue
        if now - ts > over_h * 3600:
            s["_last_prompt_ts"] = int(ts)
            l_picked.append(s)
    l_picked.sort(key=lambda s: s["_last_prompt_ts"])
    print(f"{len(l_picked)} of {len(l_sessions)} running Claude sessions are idle with a last prompt older than {over_h:g} h"
          f"{' (dry run: nothing closed)' if dry_run else ''}")
    failed = 0
    for s in l_picked:
        print(f"{s['sessionId'][:8]}  last prompt {human_age(now - s['_last_prompt_ts'])} ago ({dt_of(s['_last_prompt_ts'])})"
              f"  pid {s.get('pid')}  {s.get('name')}  {s.get('cwd')}", flush=True)
        try:
            if dry_run:
                pane = check_closeable(s)
                print(f"  would close (pane {pane})" if pane else "  would close (no terminal: plain SIGTERM)")
            else:
                close(s, by=f"idle --over {over_h:g}")
        except Refused as e:
            print(f"  {'would refuse' if dry_run else 'refused'}: {e}")
        except CloseFailed as e:
            print(f"  ERROR: {e}", file=sys.stderr)
            failed += 1
    return 1 if failed else 0


def start_self() -> str:
    """`self` and `/close`: the checks that can run now, then a detached helper (its own session, so it outlives the
    Claude process and the `!` command or hook that started it). Returns the message for the user. Raises Refused."""
    s = own_session()
    if not check_closeable(s, self_close=True, ignore_busy=True):
        raise Refused("this Claude session is not in a tmux pane: there is no screen to keep.")
    os.makedirs(os.path.dirname(SELF_LOG_PATH), exist_ok=True)
    with open(SELF_LOG_PATH, "a", encoding="utf-8") as err:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "self-helper", s["sessionId"], str(s["pid"])],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=err, start_new_session=True)
    return f"⏻ Closing this Claude session ({s.get('name') or s['sessionId'][:8]}): its screen stays here, resume typed below."


def cmd_self() -> int:
    try:
        print(start_self(), flush=True)
        return 0
    except Refused as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1


def cmd_hook() -> int:
    """Claude Code's UserPromptSubmit hook, run on every prompt: anything but /close passes untouched (no output);
    /close is blocked (never reaches the model) and starts `self`. Never fails a prompt: any error passes it on."""
    try:
        d = json.load(sys.stdin)
    except ValueError:
        return 0
    if not isinstance(d, dict) or str(d.get("prompt", "")).strip() != CLOSE_PROMPT:
        return 0
    try:
        reason = start_self()
    except Refused as e:
        reason = f"claude-close-keep-screen: not closed: {e}"
    print(json.dumps({"decision": "block", "reason": reason}))
    return 0


def cmd_self_helper(uuid: str, pid: int) -> int:
    """The detached half of `self`: wait until the session is idle, let the screen redraw, then close it."""
    path = os.path.join(CLAUDE_DIR, "sessions", f"{pid}.json")
    deadline = time.time() + SELF_WAIT_S
    status = None
    while time.time() < deadline:
        try:
            with open(path, encoding="utf-8") as f:
                status = json.load(f).get("status")
        except (OSError, ValueError):
            status = None
        if status != "busy":
            break
        time.sleep(0.2)
    time.sleep(SELF_SETTLE_S)
    try:
        s = find_session(uuid, with_tracker=False)
        if s.get("pid") != pid:
            raise Refused(f"the Claude session {uuid} is now pid {s.get('pid')}, not {pid}.")
        if s.get("status") == "busy":
            raise Refused(f"still busy after {SELF_WAIT_S:.0f} s: not closed (a new prompt was sent?).")
        close(s, by="self", self_close=True)
        return 0
    except (Refused, CloseFailed) as e:
        if not isinstance(e, CloseFailed):      # close() logs its own refusals and failures
            log({"event": "refused", "by": "self", "uuid": uuid, "pid": pid, "reason": str(e)})
        print(f"{dt_of(time.time())} {uuid}: {e}", file=sys.stderr)
        subprocess.run(["tmux", "display-message", "-d", "8000", f"claude-close-keep-screen: not closed: {e}"],
                       stderr=subprocess.DEVNULL)
        return 1


def main() -> int:
    p = argparse.ArgumentParser(prog="claude-close-keep-screen", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"claude-close-keep-screen {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)
    pc = sub.add_parser("close", help="close one running Claude session (by uuid, uuid prefix or %%pane)")
    pc.add_argument("target", help="the Claude session's uuid, a unique uuid prefix, or its tmux %%pane")
    pi = sub.add_parser("idle", help="close the Claude sessions idle for longer than --over hours")
    pi.add_argument("--over", type=float, required=True, metavar="HOURS", help="last prompt older than this many hours")
    pi.add_argument("--dry-run", action="store_true", help="list them and run the safety checks; close nothing")
    sub.add_parser("self", help="close the Claude session this runs from (`!claude-close-keep-screen self`)")
    sub.add_parser("hook", help="Claude Code's UserPromptSubmit hook: /close = self (reads the hook's JSON on stdin)")
    ph = sub.add_parser("self-helper", help="(internal) the detached half of self")
    ph.add_argument("uuid")
    ph.add_argument("pid", type=int)
    args = p.parse_args()
    if args.command == "close":
        return cmd_close(args.target)
    if args.command == "self":
        return cmd_self()
    if args.command == "hook":
        return cmd_hook()
    if args.command == "self-helper":
        return cmd_self_helper(args.uuid, args.pid)
    if args.over <= 0:
        p.error("--over must be more than 0 hours")
    return cmd_idle(args.over, args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
